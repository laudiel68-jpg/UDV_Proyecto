# Copiar a .env y cambiar los valores. El .env NO se sube al repositorio.

# --- Local (docker compose) ---
MYSQL_ROOT_PASSWORD=cambiar_root_local
MYSQL_USER=udv_app
MYSQL_PASSWORD=cambiar_clave_local
MYSQL_PORT_LOCAL=3307

# --- Railway ---
# En el servicio de la app (Variables), DATABASE_URL se arma con las
# variables del servicio MySQL, apuntando a la base db_udv:
# DATABASE_URL=mysql+pymysql://${{MySQL.MYSQLUSER}}:${{MySQL.MYSQLPASSWORD}}@${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/db_udv
